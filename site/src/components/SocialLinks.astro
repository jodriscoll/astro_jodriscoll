---
interface Props {
  email: string;
  github: string;
  linkedin: string;
  track?: boolean;
}

const { email, github, linkedin, track = false } = Astro.props;
---

<ul class="socials socials--pills">
  <li>
    <button
      type="button"
      class="platform-pill"
      data-open-contact
      data-track={track ? 'link' : undefined}
      data-track-label={track ? 'Contact' : undefined}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.4" y="6" width="17.2" height="12" rx="1.8" fill="none" style="stroke: var(--social-mail)" stroke-width="1.15"></rect>
        <path d="M4 7.35 12 12.05 20 7.35" fill="none" style="stroke: var(--social-mail)" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>Message</span>
    </button>
  </li>
  <li>
    <a
      class="platform-pill"
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      data-track={track ? 'link' : undefined}
      data-track-label={track ? 'GitHub' : undefined}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <g fill="none" style="stroke: var(--social-github)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8.3 8.5 7 4.4"></path>
          <path d="M15.7 8.5 17 4.4"></path>
          <circle cx="12" cy="11" r="3.55"></circle>
          <path d="M8.2 14.3c-.2 2.5.5 4.3 3.8 4.3s4-1.8 3.8-4.3"></path>
          <path d="M8.5 15.5 5.6 17.4"></path>
          <path d="M15.5 15.5 18.4 17.4"></path>
        </g>
        <circle cx="10.65" cy="10.7" r="0.55" style="fill: var(--social-github)"></circle>
        <circle cx="13.35" cy="10.7" r="0.55" style="fill: var(--social-github)"></circle>
      </svg>
      <span>GitHub</span>
    </a>
  </li>
  <li>
    <a
      class="platform-pill"
      href={linkedin}
      target="_blank"
      rel="noopener noreferrer"
      data-track={track ? 'link' : undefined}
      data-track-label={track ? 'LinkedIn' : undefined}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.5" y="3.5" width="17" height="17" rx="3.25" fill="none" style="stroke: var(--social-linkedin)" stroke-width="1.15"></rect>
        <path d="M8.2 10.4v5.55M8.2 8.2h.01" fill="none" style="stroke: var(--social-linkedin)" stroke-width="1.25" stroke-linecap="round"></path>
        <path d="M11.4 15.95v-3.1c0-1.12.6-1.85 1.65-1.85 1.02 0 1.6.73 1.6 1.85v3.1" fill="none" style="stroke: var(--social-linkedin)" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>LinkedIn</span>
    </a>
  </li>
</ul>
