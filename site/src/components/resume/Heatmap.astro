---
/**
 * A year of contributions in one grid. One set of cells carries all three
 * readings; the segmented control swaps which one is shown with :has(), no JS.
 */
import { contributionCells, level } from '../../lib/contributions';

interface Props {
  id?: string;
  /** compact: the masthead card. full: a section of its own. */
  variant?: 'full' | 'compact';
}

const { id = 'hm', variant = 'full' } = Astro.props;
const cells = contributionCells();
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthWeeks = [0, 4, 8, 13, 17, 22, 26, 30, 35, 39, 43, 48];
const modes = [
  { key: 'public', label: 'Public' },
  { key: 'private', label: 'Private' },
  { key: 'both', label: 'Both' },
];
---

<figure class:list={['hm', `hm--${variant}`]} data-hm-cycle>
  <fieldset class="hm__modes ds-seg">
    <legend class="sr-only">Contribution scope</legend>
    {
      modes.map((mode, index) => (
        <label data-track="contribution-filter" data-track-label={mode.label}>
          <input type="radio" name={`${id}-mode`} value={mode.key} checked={index === 0} class={`hm__in hm__in--${mode.key}`} />
          <span>{mode.label}</span>
        </label>
      ))
    }
  </fieldset>

  <div class="hm__scroll">
    <div class="hm__months" aria-hidden="true">
      {monthWeeks.map((week, index) => <span style={`grid-column: ${week + 1}`}>{months[index]}</span>)}
    </div>
    <div class="hm__grid" role="img" aria-label="Contribution pattern across the last 53 weeks">
      {
        cells.map((cell, index) => {
          const shared = cell.public > 0;
          return (
            <span
              class="hm__cell"
              style={`--i: ${index}`}
              data-pub={level(cell.public)}
              data-pri={level(cell.private)}
              data-both={shared ? level(cell.public) : level(cell.private)}
              data-only={!shared && cell.private > 0 ? '' : undefined}
            />
          );
        })
      }
    </div>
  </div>

  <figcaption class="hm__scale" aria-hidden="true">
    Less
    <i data-l="0" />
    <i data-l="1" />
    <i data-l="2" />
    <i data-l="3" />
    <i data-l="4" />
    More
    <span class="hm__only"><i class="is-only" />Private only</span>
  </figcaption>
</figure>

<script is:inline>
  // Each heatmap walks Public → Private → Both on its own, 5 seconds apiece,
  // and loops. It stops for good the moment a visitor picks a scope, and
  // pauses while it is off screen or the tab is hidden.
  (function () {
    var STEP = 5000;
    document.querySelectorAll('[data-hm-cycle]').forEach(function (fig) {
      if (fig.__hmCycle) return;
      fig.__hmCycle = true;
      var inputs = Array.prototype.slice.call(fig.querySelectorAll('.hm__modes input'));
      if (inputs.length < 2) return;
      var timer = 0, visible = true, stopped = false;
      function next() {
        if (stopped || !visible || document.hidden) return;
        var at = inputs.findIndex(function (input) { return input.checked; });
        var to = inputs[(at + 1) % inputs.length];
        to.checked = true;
        to.dispatchEvent(new Event('change', { bubbles: true }));
      }
      function start() {
        clearInterval(timer);
        if (!stopped) timer = setInterval(next, STEP);
      }
      function stop() {
        stopped = true;
        clearInterval(timer);
      }
      fig.querySelector('.hm__modes').addEventListener('pointerdown', stop);
      fig.querySelector('.hm__modes').addEventListener('keydown', stop);
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          visible = entries[0].isIntersecting;
          if (visible) start(); else clearInterval(timer);
        }).observe(fig);
      }
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) clearInterval(timer); else if (visible) start();
      });
      start();
    });
  })();
</script>

<style>
  .hm {
    --hm-0: var(--ds-ink-5);
    --hm-1: var(--ds-ink-20);
    --hm-2: var(--ds-ink-35);
    --hm-3: var(--ds-ink-70);
    --hm-4: var(--ds-fg);
    margin: 0;
  }

  .hm__modes {
    display: inline-flex;
    margin: 0 0 var(--ds-space-5);
    padding: 3px;
    border: var(--ds-hairline) solid var(--ds-rule-strong);
    border-radius: var(--ds-radius-pill);
  }

  .hm__modes label {
    position: relative;
    cursor: pointer;
  }

  .hm__modes input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .hm__modes span {
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 var(--ds-space-3);
    border-radius: var(--ds-radius-pill);
    color: var(--ds-fg-muted);
    font-size: var(--ds-text-xs);
    transition:
      background-color var(--ds-dur-fast),
      color var(--ds-dur-fast);
  }

  .hm__modes input:checked + span {
    background: var(--ds-fg);
    color: var(--ds-on-fg);
  }

  .hm__modes input:focus-visible + span {
    outline: 2px solid var(--ds-accent);
    outline-offset: 2px;
  }

  /* The heatmap always fits its container: 53 week columns that shrink with it
     (cells stay square), never a horizontal scrollbar. */
  .hm__scroll {
    max-width: 920px;
    min-width: 0;
  }

  .hm__months,
  .hm__grid {
    display: grid;
    grid-template-columns: repeat(53, minmax(0, 1fr));
    gap: 3px;
    min-width: 0;
  }

  .hm__months {
    margin-bottom: var(--ds-space-2);
    font-family: var(--ds-font-mono);
    font-size: var(--ds-text-2xs);
    color: var(--ds-fg-faint);
  }

  .hm__months span {
    grid-row: 1;
    white-space: nowrap;
  }

  .hm__grid {
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
  }

  .hm__cell {
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--hm-0);
  }

  /* Public */
  .hm:has(.hm__in--public:checked) .hm__cell[data-pub="1"] { background: var(--hm-1); }
  .hm:has(.hm__in--public:checked) .hm__cell[data-pub="2"] { background: var(--hm-2); }
  .hm:has(.hm__in--public:checked) .hm__cell[data-pub="3"] { background: var(--hm-3); }
  .hm:has(.hm__in--public:checked) .hm__cell[data-pub="4"] { background: var(--hm-4); }

  /* Private: the fuller shape */
  .hm:has(.hm__in--private:checked) .hm__cell[data-pri="1"] { background: var(--hm-1); }
  .hm:has(.hm__in--private:checked) .hm__cell[data-pri="2"] { background: var(--hm-2); }
  .hm:has(.hm__in--private:checked) .hm__cell[data-pri="3"] { background: var(--hm-3); }
  .hm:has(.hm__in--private:checked) .hm__cell[data-pri="4"] { background: var(--hm-4); }

  /* Both: public fill, private-only cells outlined in the accent */
  .hm:has(.hm__in--both:checked) .hm__cell[data-both="1"] { background: var(--hm-1); }
  .hm:has(.hm__in--both:checked) .hm__cell[data-both="2"] { background: var(--hm-2); }
  .hm:has(.hm__in--both:checked) .hm__cell[data-both="3"] { background: var(--hm-3); }
  .hm:has(.hm__in--both:checked) .hm__cell[data-both="4"] { background: var(--hm-4); }
  .hm:has(.hm__in--both:checked) .hm__cell[data-only] {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--ds-accent);
  }

  /* The old activity graph's bloom: a slow wave rolls across the year, each
     active cell brightening to full ink as it passes. */
  @media (prefers-reduced-motion: no-preference) {
    .hm__cell {
      animation:
        hm-in 0.6s var(--ds-ease-out) both,
        hm-bloom 5.4s ease-in-out infinite;
      animation-delay:
        calc(var(--i) * 2ms),
        calc(var(--i) * -48ms);
    }

    .hm__cell[data-pri="0"] {
      animation: hm-in 0.6s var(--ds-ease-out) both;
      animation-delay: calc(var(--i) * 2ms);
    }
  }

  @keyframes hm-in {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes hm-bloom {
    0%,
    40%,
    64%,
    100% {
      filter: none;
    }

    52% {
      filter: brightness(2.2);
    }
  }

  /* ---- Compact: the masthead card ---- */
  .hm--compact .hm__modes {
    margin-bottom: var(--ds-space-3);
  }

  .hm--compact .hm__modes span {
    height: 22px;
    padding: 0 var(--ds-space-2);
    font-size: var(--ds-text-2xs);
  }

  .hm--compact .hm__scroll {
    max-width: none;
  }

  .hm--compact .hm__months,
  .hm--compact .hm__grid {
    gap: 2px;
  }

  .hm--compact .hm__months {
    font-size: 9px;
  }

  .hm--compact .hm__months span:nth-child(even) {
    visibility: hidden;
  }

  .hm--compact .hm__cell {
    border-radius: 1px;
  }

  .hm--compact .hm__scale {
    font-size: 10px;
  }

  .hm--compact .hm__scale i {
    width: 8px;
    height: 8px;
  }

  .hm__scale {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    margin-top: var(--ds-space-3);
    color: var(--ds-fg-faint);
    font-size: var(--ds-text-2xs);
  }

  .hm__scale i {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--hm-0);
  }

  .hm__scale i[data-l="1"] { background: var(--hm-1); }
  .hm__scale i[data-l="2"] { background: var(--hm-2); }
  .hm__scale i[data-l="3"] { background: var(--hm-3); }
  .hm__scale i[data-l="4"] { background: var(--hm-4); }

  .hm__only {
    display: none;
    align-items: center;
    gap: 4px;
    margin-left: var(--ds-space-4);
  }

  .hm__scale i.is-only {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--ds-accent);
  }

  .hm:has(.hm__in--both:checked) .hm__only {
    display: inline-flex;
  }
</style>
