---

<ul class="comfort">
  {
    items.map((facet) => (
      <li class="comfort__row" style={`--tile: var(--accent-${facet.accent})`}>
        <span class="comfort__icon" aria-hidden="true" set:html={icons[facet.id] ?? icons.javascript} />
        <div class="comfort__col">
          <div class="comfort__track" role="img" aria-label={`${facet.label}, ${facet.depth}`}>
            <span class="comfort__fill" style={`width: ${facet.fill}%`} />
          </div>
          <p class="comfort__copy">
            <span class="comfort__name">{facet.label}</span>
            <span>{facet.depth}</span>
          </p>
        </div>
      </li>
    ))
  }
</ul>
