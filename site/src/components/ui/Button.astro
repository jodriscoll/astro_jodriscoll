---
/**
 * The one button. href renders a link, otherwise a <button type="button">.
 * Any other attribute (data-open-contact, data-track, aria-*) passes through.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  href?: string;
  variant?: 'primary' | 'ghost' | 'quiet';
  size?: 'sm' | 'md';
};

const { href, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props as Props & { class?: string };
const Tag = href ? 'a' : 'button';
const extra = href ? { href } : { type: 'button' };
---

<Tag class:list={['ds-button', `ds-button--${variant}`, `ds-button--${size}`, className]} {...extra} {...rest}>
  <slot name="icon" />
  <slot />
</Tag>

<style>
  .ds-button {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-space-2);
    height: var(--ds-control-h);
    padding: 0 18px;
    border: var(--ds-hairline) solid var(--ds-fg);
    border-radius: var(--ds-radius-pill);
    background: var(--ds-fg);
    color: var(--ds-on-fg);
    font: inherit;
    font-size: var(--ds-text-sm);
    font-weight: var(--ds-weight-medium);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      opacity var(--ds-dur-fast),
      background-color var(--ds-dur-fast),
      color var(--ds-dur-fast),
      border-color var(--ds-dur-fast);
  }

  .ds-button:hover {
    opacity: 0.86;
  }

  .ds-button:focus-visible {
    outline: 2px solid var(--ds-accent);
    outline-offset: 2px;
  }

  .ds-button--ghost {
    background: transparent;
    border-color: var(--ds-rule-strong);
    color: var(--ds-fg);
  }

  .ds-button--ghost:hover {
    opacity: 1;
    border-color: var(--ds-fg);
  }

  .ds-button--quiet {
    padding: 0 var(--ds-space-2);
    background: transparent;
    border-color: transparent;
    color: var(--ds-fg-muted);
  }

  .ds-button--quiet:hover {
    opacity: 1;
    color: var(--ds-fg);
  }

  .ds-button--sm {
    height: var(--ds-control-h-sm);
    padding: 0 var(--ds-space-3);
    font-size: var(--ds-text-xs);
  }

  .ds-button :global(svg) {
    width: 15px;
    height: 15px;
    flex: none;
  }
</style>
